# ZUI Library Internal Resources
# These are embedded into libzui and available via res:/zui/...

# Window decoration icons
zui/icons/close.svg = ../assets/icons/x-exit-icon.svg
zui/icons/minimize.svg = ../assets/icons/x-minimize-icon.svg
zui/icons/maximize.svg = ../assets/icons/x-maximize-icon.svg
zui/icons/restore.svg = ../assets/icons/x-restore-icon.svg
zui/icons/hidden.svg = ../assets/icons/x-hidden-icon.svg

# UI icons
zui/icons/check.svg = ../assets/icons/x-check-icon.svg
zui/icons/chevron-up.svg = ../assets/icons/x-chevron-up.svg
zui/icons/chevron-down.svg = ../assets/icons/x-chevron-down.svg

# Logo
zui/logo/white.png = ../assets/logo/zui-logo-white.png
